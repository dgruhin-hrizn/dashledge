{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edge Workbench",
  "version": "0.1.0",
  "identifier": "dev.edgeworkbench.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
