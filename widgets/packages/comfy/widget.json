{
  "apiVersion": 2,
  "id": "comfy",
  "title": "ComfyUI",
  "description": "Live render queues, worker activity and image previews.",
  "version": "1.0.0",
  "category": "AI & development",
  "icon": "view/comfy-icon.svg",
  "view": {
    "entry": "view/index.html",
    "viewport": "reference"
  },
  "sources": {
    "min": 1,
    "max": 2,
    "auth": "bearer",
    "address": "path",
    "test": [
      "queue",
      "system_stats"
    ],
    "addressLabel": "Worker URL",
    "addressPlaceholder": "http://worker.local:8188",
    "credentialLabel": "Optional bearer token"
  },
  "collector": {
    "entry": "collector/capture.mjs",
    "outputs": [
      "snapshot.js",
      "previews/*.jpg"
    ]
  }
}
