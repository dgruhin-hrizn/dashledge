{
  "apiVersion": 2,
  "id": "omlx",
  "title": "oMLX",
  "description": "Live decode speed, loaded models and inference history.",
  "version": "1.4.2",
  "category": "AI & development",
  "icon": "view/omlx-icon.svg",
  "view": {
    "entry": "view/index.html",
    "viewport": "native"
  },
  "sources": {
    "min": 1,
    "max": 20,
    "auth": "bearer",
    "address": "origin",
    "test": [
      "api/status"
    ],
    "addressLabel": "Server URL",
    "addressPlaceholder": "http://localhost:8000",
    "credentialLabel": "oMLX API key"
  },
  "collector": {
    "entry": "collector/collect.mjs",
    "outputs": [
      "snapshot.js"
    ],
    "commands": [
      "model"
    ]
  }
}
