{
  "apiVersion": 2,
  "id": "proxmox",
  "title": "Proxmox",
  "description": "Cluster health, virtual machines and GPU telemetry.",
  "version": "1.5.2",
  "category": "Servers & storage",
  "icon": "view/icon.svg",
  "view": {
    "entry": "view/index.html",
    "viewport": "native",
    "theme": true
  },
  "sources": {
    "min": 1,
    "max": 1,
    "auth": "pve-token",
    "address": "path",
    "test": [
      "api2/json/cluster/resources"
    ],
    "addressLabel": "Cluster URL (usually port 8006)",
    "addressPlaceholder": "https://pve.local:8006",
    "credentialLabel": "API token ID=secret"
  },
  "collector": {
    "entry": "collector/collect.mjs",
    "outputs": [
      "snapshot.js"
    ]
  },
  "displayName": {
    "serverField": "data.name"
  }
}
